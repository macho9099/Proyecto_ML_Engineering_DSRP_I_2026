# Copiar a .env y completar. El archivo .env NO se versiona (.gitignore).

# --- Datos crudos de la competencia MITSUI (Kaggle) --------------------------
# Carpeta que contiene train.csv, train_labels.csv, test.csv, target_pairs.csv
RAW_DATA_DIR=D:/ruta/a/mitsui-commodity-prediction-challenge

# --- MLflow / DagsHub --------------------------------------------------------
# Vacío o ausente -> tracking local en ./mlruns
# Para publicar los experimentos en DagsHub:
#   MLFLOW_TRACKING_URI=https://dagshub.com/<usuario>/<repo>.mlflow
#   MLFLOW_TRACKING_USERNAME=<usuario de DagsHub>
#   MLFLOW_TRACKING_PASSWORD=<token de DagsHub (Settings -> Tokens)>
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Opcionales (tienen valores por defecto)
# MLFLOW_EXPERIMENT=mitsui-target4
# MLFLOW_REGISTERED_MODEL=mitsui-target4-regressor
